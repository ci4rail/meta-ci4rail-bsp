# Based on https://raw.githubusercontent.com/mendersoftware/app-update-module/1.0.0/src/app-modules/docker-compose
# CI4Rail: Docker Compose v2, persistent image snapshots and optional readiness checks.

set -e
MODULE_CONFIG_FILE="${MENDER_APP_COMPOSE_CONFIG_FILE:-/etc/mender/mender-app-docker-compose.conf}"
if test -f "$MODULE_CONFIG_FILE"; then
    . "$MODULE_CONFIG_FILE"
fi

# Keep image/delta temporary files on the persistent data filesystem.
export TMPDIR="${TMPDIR:-/data/containers/tmp}"
mkdir -p "$TMPDIR"

_docker_compose_cmd=""
docker_cmd=${DOCKER_COMMAND:-"docker"}
delta_executable=${XDELTA_COMMAND:-"xdelta3"}
delta_arguments=${XDELTA_ARGS:-"-d -s"}
delta_cmd="${delta_executable} ${delta_arguments}"

_discover_compose() {
    local version
    _docker_compose_cmd="${DOCKER_COMPOSE_COMMAND:-$docker_cmd compose}"
    version=$($_docker_compose_cmd version --short) || return $?
    case "$version" in
        2.*|v2.*) ;;
        *) echo "Docker Compose v2 is required; found: $version" >&2; return 1 ;;
    esac
}

# docker_compose_cmd project_dir command
docker_compose_cmd() {
    if test -z "${_docker_compose_cmd}"; then
        local rc=0
        _discover_compose
        rc=$?
        if test $rc -ne 0; then
            return $rc
        fi
    fi
    local project_dir="$1"
    shift
    # Logs must not contaminate config/ps output consumed by callers.
    echo "docker-compose:running:$_docker_compose_cmd $*" >&2
    if test -f "$project_dir/.mender-compose.yml"; then
        set -- -f "$project_dir/.mender-compose.yml" -f "$project_dir/.mender-images.yml" "$@"
    fi
    $_docker_compose_cmd --project-directory "$project_dir" "$@"
}

unpack_image() {
    local input_file="$1"
    local image_dir="$2"

    if test -d "${image_dir}"; then
        rm -Rf "${image_dir}"
    fi
    mkdir -p "${image_dir}"
    tar xvf "$input_file" -C "${image_dir}"
}

# given a checksum and a directory find matching layer.tar
# be careful what you echo to stdout from this function:
# it prints the path to a layer
find_layer_by_sum() {
    local sum="$1"
    local dir="$2"
    local file_list

    if test "$sum" = ""; then
        return 1
    fi
    file_list=$(mktemp)
    find "$dir" -name layer.tar -exec sha256sum {} \; > "${file_list}"
    cat "$file_list" | sed -ne "/^${sum}/s/^${sum}[ ]*//p"
    rm -f "${file_list}"
}

# given current and new image directories and the binary delta of a layer
# apply and save the layer.tar in the new image dir
apply_layer_delta() {
    local current_image_dir="$1"
    local new_image_dir="$2"
    local vcdiff="$3"
    local current_sum_file
    local new_sum_file
    local current_sum
    local new_sum
    local output_layer
    local current_layer_tar
    local new_layer_tar

    current_sum_file=$(echo "$vcdiff" | sed -e 's/.vcdiff$/.current.sha256sum/')
    new_sum_file=$(echo "$vcdiff" | sed -e 's/.vcdiff$/.new.sha256sum/')
    output_layer=$(echo "$vcdiff" | sed -e 's/.vcdiff$//')
    current_sum=$(cat "${current_sum_file}")
    new_sum=$(cat "${new_sum_file}")
    # we need to find the corresponding layer in current_image_dir and encode the
    # delta in new_image_dir, in the directory we must also find by layer.tar sum
    current_layer=$(find_layer_by_sum "${current_sum}" "${current_image_dir}")
    if test "$current_layer" = ""; then
        echo "ERROR: cant find current layer by checksum: ${current_sum}"
        return 1
    fi
    $delta_cmd "$current_layer" "${vcdiff}" "${output_layer}"
    # we could here verify the sums here, a bit redundant.
    rm -f "${current_sum_file}" "${new_sum_file}" "${vcdiff}"
}

# given current and new image directories and the binary delta of a layer
# apply and save the layer.tar in the new image dir
apply_layer_delta_oci() {
    local current_image_dir="$1"
    local new_image_dir="$2"
    local vcdiff="$3"
    local current_file
    local new_sum_file

    current_file=$(echo "$vcdiff" | sed -e 's/\.vcdiff$//')
    current_file=$(cat "$current_file".source)
    current_file="${current_image_dir}/$current_file"
    new_file=$(echo "$vcdiff" | sed -e 's/\.vcdiff$//')
    $delta_cmd "$current_file" "${vcdiff}" "${new_file}"
}

# |-- ecaa1158057a2e325f72c5e43c9847fbef370da5a65d6534b1708c99feb7c0e7
#|   |-- VERSION
#|   |-- json
#|   |-- layer.tar.current.sha256sum
#|   |-- layer.tar.new.sha256sum
#|   `-- layer.tar.vcdiff
resolve_deep_delta() {
    local application_name="$1"
    local input_file="$2"
    local current_url="$3"
    local new_image_dir="${MODULE_TMPDIR:-${TMPDIR}}"
    local current_image_dir="${MODULE_TMPDIR:-${TMPDIR}}"
    local current_image_file
    local vcdiff
    local image_dir="${MODULE_TMPDIR:-${TMPDIR}}"

    if test ! -d "$new_image_dir"; then
        echo "ERROR: neither MODULE_TMPDIR or TMPDIR is set"
        return 1
    fi
    if test ! -d "$current_image_dir"; then
        echo "ERROR: neither MODULE_TMPDIR or TMPDIR is set"
        return 1
    fi
    if test ! -d "$image_dir"; then
        echo "ERROR: neither MODULE_TMPDIR or TMPDIR is set"
        return 1
    fi
    current_image_file="${image_dir}"/$(echo "${current_url}" | sha256sum | cut -f1 -d' ')
    if test -f "$current_image_file"; then
        rm -f "${current_image_file}"
    fi
    app_save "${application_name}" "$current_url" "${current_image_file}"
    new_image_dir="${image_dir}/image-$(sha256sum "${input_file}" | cut -f1 -d' ')"
    current_image_dir="${image_dir}/image-$(sha256sum "${current_image_file}" | cut -f1 -d' ')"
    unpack_image "${input_file}" "${new_image_dir}"
    unpack_image "${current_image_file}" "${current_image_dir}"

    if test -f "${new_image_dir}"/oci-layout; then
        if test ! -f "${current_image_dir}"/oci-layout; then
            echo "ERROR: current image is not in OCI format while the new one is, cant continue with deep delta."
            return 1
        fi

        for vcdiff in "${new_image_dir}"/*/*/*.vcdiff; do # FIXME: this is not the way files should be scanned -- change to find and temp file (remember /bin/sh compatibility);
            if test ! -f "$vcdiff"; then
                break
            fi
            apply_layer_delta_oci "${current_image_dir}" "${new_image_dir}" "${vcdiff}"
        done
    else
        if test -f "${current_image_dir}"/oci-layout; then
            echo "ERROR: current image is in OCI format while the new one is not, cant continue with deep delta."
            return 1
        fi

        for vcdiff in "${new_image_dir}"/*/layer.tar.vcdiff; do # FIXME: this is not the way files should be scanned -- change to find and temp file (remember /bin/sh compatibility);
            if test ! -f "$vcdiff"; then
                break
            fi
            apply_layer_delta "${current_image_dir}" "${new_image_dir}" "${vcdiff}"
        done
    fi
    rm -f "${input_file}"
    tar cf "${input_file}" -C "${new_image_dir}" .
}

app_load() {
    local application_name="$1"
    local url="$2"
    local input_file="$3"
    local url_current="$4"

    if test "$OPTIONS" = "deep_delta"; then
        if test "$MODULE_TMPDIR" = ""; then
            echo "ERROR: ${MODULE_TMPDIR} cant be empty"
            return 1
        fi
        if ! test -d "$MODULE_TMPDIR"; then
            echo "ERROR: ${MODULE_TMPDIR} does not exist as a directory"
            return 1
        fi
        resolve_deep_delta "${application_name}" "${input_file}" "${url_current}"
    fi
    $docker_cmd image load < "$input_file"
}

app_save() {
    local application_name="$1"
    local url="$2"
    local output_file="$3"

    $docker_cmd image save "$url" -o "$output_file"
}

# Use engine labels rather than Compose's version-dependent ps JSON format.
service_containers() {
    $docker_cmd ps -aq --filter "label=com.docker.compose.project=$1" \
        --filter "label=com.docker.compose.service=$2" \
        --filter "label=com.docker.compose.oneoff=False"
}

# Resolve at the final path so relative bind mounts keep their canonical paths.
# Save substitutions once; later artifacts may supply different environment values.
app_resolve() {
    docker_compose_cmd "$2" --project-name "$1" config --format json > "$2/.mender-compose.yml.new"
    printf '{"services": {}}\n' > "$2/.mender-images.yml.new"
    mv "$2/.mender-images.yml.new" "$2/.mender-images.yml"
    mv "$2/.mender-compose.yml.new" "$2/.mender-compose.yml"
}

app_validate() {
    docker_compose_cmd "$2" --project-name "$1" config >/dev/null
}

# Archive by immutable ID, and record mutable tags separately. This survives
# image load moving a tag, and rollback works without registry/network access.
backup_references() {
    local refs="$1" backup="$2" ref id
    mkdir -p "$backup"
    : > "$backup/tags"
    : > "$backup/ids"
    while IFS= read -r ref; do
        test -n "$ref" || continue
        if id=$($docker_cmd image inspect --format '{{.Id}}' "$ref" 2>/dev/null); then
            printf '%s\n' "$id" >> "$backup/ids"
            case "$ref" in
                sha256:*|*@*) ;;
                *) printf '%s %s\n' "$id" "$ref" >> "$backup/tags" ;;
            esac
        else
            # Missing images need no backup; an unavailable engine must fail
            # preparation rather than silently discard an existing tag mapping.
            $docker_cmd info >/dev/null
        fi
    done < "$refs"
}

save_backup() {
    local backup="$1"
    sort -u "$backup/ids" > "$backup/unique-ids"
    if test -s "$backup/unique-ids"; then
        # IDs contain no whitespace or shell metacharacters.
        $docker_cmd image save -o "$backup/images.tar" $(cat "$backup/unique-ids")
    fi
}

app_snapshot() {
    local application_name="$1" manifests_dir="$2" backup="$3"
    local services service ids id image first info
    mkdir -p "$backup"
    docker_compose_cmd "$manifests_dir" --project-name "$application_name" config --format json > "$backup/compose.json"
    # Restoring archived images must never depend on registry availability.
    jq '(.services[].pull_policy) = "never"' "$backup/compose.json" > "$backup/compose.yml"
    : > "$backup/refs"
    : > "$backup/runtime-ids"
    services=$(jq -r '.services | keys[]' "$backup/compose.yml")
    test -n "$services" || { echo "Cannot snapshot an empty composition" >&2; return 1; }
    printf '{"services": {}}\n' > "$backup/images.yml"
    for service in $services; do
        ids=$(service_containers "$application_name" "$service")
        test -n "$ids" || { echo "Cannot snapshot service without a container: $service" >&2; return 1; }
        first=""
        for id in $ids; do
            info=$($docker_cmd inspect "$id")
            image=$(printf '%s\n' "$info" | jq -er '.[0].Image')
            printf '%s\n' "$info" | jq -er '.[0].Config.Image' >> "$backup/refs"
            if test -n "$first" && test "$first" != "$image"; then
                echo "Service $service has mixed image versions" >&2
                return 1
            fi
            first="$image"
            printf '%s\n' "$image" >> "$backup/runtime-ids"
        done
        jq --arg service "$service" --arg image "$first" \
            '.services[$service].image = $image' "$backup/images.yml" > "$backup/images.yml.new"
        mv "$backup/images.yml.new" "$backup/images.yml"
    done
    backup_references "$backup/refs" "$backup"
    cat "$backup/runtime-ids" >> "$backup/ids"
    save_backup "$backup"
}

app_restore() {
    local backup="$2" id ref
    test -f "$backup/tags" || { echo "Missing image backup: $backup" >&2; return 1; }
    if test -f "$backup/images.tar"; then
        $docker_cmd image load -i "$backup/images.tar"
    elif test -s "$backup/ids"; then
        echo "Missing image archive: $backup" >&2
        return 1
    fi
    while read -r id ref; do
        test -n "$id" || continue
        $docker_cmd image tag "$id" "$ref"
    done < "$backup/tags"
}

validate_health_settings() {
    case "${APP_HEALTHCHECK_ENABLED:-no}" in
        no) return 0 ;;
        yes) ;;
        *) echo "APP_HEALTHCHECK_ENABLED must be yes or no" >&2; return 1 ;;
    esac
    case "${APP_HEALTHCHECK_TIMEOUT:-60}:${APP_HEALTHCHECK_INTERVAL:-2}" in
        *[!0-9:]*|:*|*:) echo "Invalid health-check timing" >&2; return 1 ;;
    esac
    test "${APP_HEALTHCHECK_TIMEOUT:-60}" -gt 0 && test "${APP_HEALTHCHECK_INTERVAL:-2}" -gt 0 || return 1
}

app_healthy() {
    local application_name="$1" manifests_dir="$2"
    local services service ids id state ready deadline now
    validate_health_settings
    test "${APP_HEALTHCHECK_ENABLED:-no}" = yes || return 0
    deadline=$(($(date +%s) + ${APP_HEALTHCHECK_TIMEOUT:-60}))
    services=$(docker_compose_cmd "$manifests_dir" --project-name "$application_name" config --services)
    test -n "$services" || { echo "No services to check" >&2; return 1; }
    while :; do
        ready=yes
        for service in $services; do
            ids=$(service_containers "$application_name" "$service")
            test -n "$ids" || ready=no
            for id in $ids; do
                state=$($docker_cmd inspect "$id")
                if ! printf '%s\n' "$state" | jq -e '.[0] |
                    if .Config.Labels["io.ci4rail.mender.oneshot"] == "true" then
                        .State.Status == "exited" and .State.ExitCode == 0
                    else
                        .State.Running == true and (.State.Restarting != true) and
                        (.State.Paused != true) and
                        ((.State.Health.Status // "healthy") == "healthy")
                    end' >/dev/null; then
                    ready=no
                fi
            done
        done
        test "$ready" = yes && return 0
        now=$(date +%s)
        if test "$now" -ge "$deadline"; then
            echo "Application $application_name did not become ready within ${APP_HEALTHCHECK_TIMEOUT:-60}s" >&2
            return 1
        fi
        sleep "${APP_HEALTHCHECK_INTERVAL:-2}"
    done
}

app_rollout() {
    local application_name="$1" manifests_dir="$2" rc
    if docker_compose_cmd "$manifests_dir" --project-name "$application_name" \
        up -d --remove-orphans > "$manifests_dir/compose.log" 2>&1; then
        app_healthy "$application_name" "$manifests_dir"
    else
        rc=$?
        cat "$manifests_dir/compose.log" >&2
        return "$rc"
    fi
}

app_stop() {
    docker_compose_cmd "$2" --project-name "$1" down >> "$2/compose.log" 2>&1
}

app_requirements() {
    validate_health_settings
    $docker_cmd version >/dev/null
    command -v jq >/dev/null
    _discover_compose
}

case "$1" in
    SAVE) shift; app_save "$@" ;;
    LOAD) shift; app_load "$@" ;;
    ROLLOUT) shift; app_rollout "$@" ;;
    STOP) shift; app_stop "$@" ;;
    ENSURE_ABSENT)
        ids=$($docker_cmd ps -aq --filter "label=com.docker.compose.project=$2")
        if test -n "$ids"; then
            echo "Project $2 exists without managed manifests; cannot guarantee rollback" >&2
            exit 1
        fi
        ;;
    VALIDATE) shift; app_validate "$@" ;;
    RESOLVE) shift; app_resolve "$@" ;;
    SNAPSHOT) shift; app_snapshot "$@" ;;
    BACKUP_IMAGES) shift; backup_references "$1" "$2"; save_backup "$2" ;;
    RESTORE) shift; app_restore "$@" ;;
    ROLLBACK)
        shift
        app_stop "$1" "$3"
        app_rollout "$1" "$2/manifests"
        ;;
    HEALTHY|ALIVE) shift; app_healthy "$@" ;;
    REQS) app_requirements ;;
    EXPORT_MANIFEST|LS_COMPONENTS|PURGE|START) true ;;
    DELETE) shift; $docker_cmd image rm "$1" ;;
    *) echo "ERROR: unknown API call: $*" >&2; exit 1 ;;
esac
