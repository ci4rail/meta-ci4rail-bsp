#!/bin/sh

DEVICE="@MENDER_STORAGE_DEVICE@"
PART_NUM="@MENDER_DATA_PART_NUMBER@"
PARTITION="${DEVICE}p${PART_NUM}"
UBOOT_ENV_OFFSET_1="@MENDER_UBOOT_ENV_STORAGE_DEVICE_OFFSET_1@"
UBOOT_ENV_OFFSET_2="@MENDER_UBOOT_ENV_STORAGE_DEVICE_OFFSET_2@"
UBOOT_ENV_SIZE="@BOOTENV_SIZE@"

clear_u_boot_env() {
    offset="$1"

    if [ -z "$offset" ] || [ -z "$UBOOT_ENV_SIZE" ]; then
        echo "[ERROR] Missing U-Boot environment offset or size"
        exit 1
    fi

    offset_bytes=$((offset))
    size_bytes=$((UBOOT_ENV_SIZE))

    echo "[INFO] Clearing U-Boot environment at ${DEVICE}, offset ${offset_bytes}, size ${size_bytes}..."
    dd if=/dev/zero of="$DEVICE" bs=1 seek="$offset_bytes" count="$size_bytes" conv=notrunc
}

clear_u_boot_env "$UBOOT_ENV_OFFSET_1"
clear_u_boot_env "$UBOOT_ENV_OFFSET_2"

echo "[INFO] Resizing partition ${PARTITION} to fill remaining space..."

# Get the start sector of partition
START_SECTOR=$(fdisk -l "$DEVICE" | awk -v part="$PARTITION" '$1 == part { print $4 }')

if [ -z "$START_SECTOR" ]; then
    echo "[ERROR] Could not find start sector of $PARTITION"
    exit 1
fi

echo "[INFO] Found start sector: $START_SECTOR"

# Create fdisk script
FDISK_SCRIPT=$(mktemp)
cat <<EOF > "$FDISK_SCRIPT"
d
$PART_NUM
n
p
$START_SECTOR

w
EOF

# Apply the fdisk script
fdisk "$DEVICE" < "$FDISK_SCRIPT"

# Remove temp file
rm "$FDISK_SCRIPT"

echo "tezi-installer-finished" > /dev/console
