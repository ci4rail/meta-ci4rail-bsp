[Unit]
Description=Activate Wireless Access Point
BindsTo=sys-subsystem-net-devices-uap0.device
After=sys-subsystem-net-devices-uap0.device
After=systemd-networkd.service
After=NetworkManager.service

[Service]
Type=forking
PIDFile=/run/hostapd.pid
ExecStartPre=/usr/bin/shared-access-point
ExecStartPre=/usr/bin/setup-dhcp-uap0
ExecStart=@SBINDIR@/hostapd @SYSCONFDIR@/access-point.conf -P /run/hostapd.pid -B
ExecStopPost=/usr/bin/rm -f /etc/systemd/network/access-point.network


[Install]
WantedBy=network.target
