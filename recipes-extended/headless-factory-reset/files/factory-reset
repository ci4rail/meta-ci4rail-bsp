#!/bin/bash

set -euo pipefail

echo "===================="
echo "SYSTEM FACTORY RESET"
echo "===================="
if [[ -z "${FACTORY_RESET_SKIP_CONFIRMATION:-}" ]]; then
    echo "If you continue, all data on this system will be permanently deleted and the factory settings are restored."
    read -r -p "Type 'RESET' to confirm: " confirmation
    if [[ "$confirmation" != "RESET" ]]; then
        echo "Confirmation not received. Exiting."
        exit 1
    fi
    echo "Confirmation received. System reset to factory condition initiated..."
else
    echo "Skipping confirmation because FACTORY_RESET_SKIP_CONFIRMATION is set."
fi
echo "During the reset process, the system will become unresponsive for a short period."
sleep 5

echo "Stopping all services by entering headless-reset-system mode..."
systemctl isolate headless-reset-system.target
